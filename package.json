{
  "name": "soulseek-enhancer",
  "version": "0.1.0",
  "description": "Personal Soulseek download manager: wantlist-driven search, ranked candidates, peer blacklist, CSV import — on top of slskd",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cratepilot/soulseek-enhancer.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build web",
    "build:desktop": "tsc -p tsconfig.desktop.json",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.desktop.json --noEmit",
    "test": "vitest run",
    "dev:server": "tsx watch src/index.ts",
    "dev:web": "vite web",
    "start": "node dist/index.js",
    "dist": "npm run build && npm run build:desktop && electron-builder --publish never"
  },
  "dependencies": {
    "@cratepilot/soulseek-toolkit": "file:../soulseek-toolkit",
    "@fastify/static": "^8.0.0",
    "fastify": "^5.3.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.3"
  }
}
